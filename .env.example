# Native Linux/WSL development. ./scripts/optiq setup generates real secrets.
DEBUG=true
DATABASE_URL=sqlite:///.local/optiq.db
JOB_BACKEND=thread
MAIL_BACKEND=file
MAIL_DIRECTORY=.local/mail
MLFLOW_TRACKING_URI=
JWT_SECRET=__JWT_SECRET__
FERNET_KEY=__FERNET_KEY__
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
FRONTEND_URL=http://localhost:3000
# Optional additional browser origins, as a JSON array. FRONTEND_URL is always allowed.
CORS_ORIGINS=[]
OLLAMA_BASE_URL=http://localhost:11434
GOOGLE_CLIENT_ID=

# Used when JOB_BACKEND=rq / MAIL_BACKEND=smtp.
REDIS_URL=redis://localhost:6379/0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Optiq <noreply@optiq.local>
SMTP_USE_TLS=true
RESEND_API_KEY=

# Browser configuration is written to frontend/.env.local by setup.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MLFLOW_URL=

# Compose uses separate service addresses; it never uses the native SQLite URL.
POSTGRES_USER=optiq
POSTGRES_PASSWORD=optiq_dev_password
POSTGRES_DB=optiq
COMPOSE_FRONTEND_PORT=3001
COMPOSE_API_PORT=8000
COMPOSE_MAIL_PORT=8025
COMPOSE_MLFLOW_PORT=5000
COMPOSE_OLLAMA_BASE_URL=http://host.docker.internal:11434
COMPOSE_MLFLOW_TRACKING_URI=
INSTALL_EXTRAS=false
