# Copy to .env and fill in values before running docker compose

# PostgreSQL (app database)
POSTGRES_USER=optiq
POSTGRES_PASSWORD=optiq_dev_password
POSTGRES_DB=optiq
DATABASE_URL=postgresql+psycopg2://optiq:optiq_dev_password@postgres:5432/optiq

# Redis (RQ job queue)
REDIS_URL=redis://redis:6379/0

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_BACKEND_STORE_URI=postgresql://optiq:optiq_dev_password@postgres:5432/mlflow
MLFLOW_ARTIFACT_ROOT=/mlflow/artifacts

# Backend security
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
FERNET_KEY=generate-with-python-cryptography-fernet-generate-key

# CORS
FRONTEND_URL=http://localhost:3000

# Host-side Ollama from Docker (Windows/Mac Docker Desktop)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Mail (required to sign up). Local Docker uses Mailpit (http://localhost:8025).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Optiq <noreply@optiq.local>
SMTP_USE_TLS=false
RESEND_API_KEY=

GOOGLE_CLIENT_ID=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MLFLOW_URL=http://localhost:5000
