#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
for candidate in "${OPTIQ_PYTHON:-python3}" python3.11 python3.12 python3.13 python3.14; do
  if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
    exec "$candidate" "$root/scripts/develop.py" "$@"
  fi
done
echo 'Python 3.11+ is required. Install it for your distro, or set OPTIQ_PYTHON to its executable.' >&2
exit 1
